# Copy this file to .env and fill in your values
# NEVER commit .env to git

# DeepSeek API key — get yours at https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-...

# hiring.cafe API base URL (verify in browser devtools before use)
HIRING_CAFE_URL=https://hiring.cafe

# Path to your profile JSON (default: ./profile.json)
PROFILE_PATH=./profile.json

# LangSmith tracing — get your key at https://smith.langchain.com/settings
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=job-matcher
